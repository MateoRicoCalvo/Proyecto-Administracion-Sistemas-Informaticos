#!/bin/bash

# módulo que crea (o elimina) un volumen lógico dentro de un grupo de volúmenes (VG)

# argumentos:
#   "lv": nombre del LV (obligatorio)
#   "vg": nombre del VG (obligatorio)
#   "state": "present"|"absent" (por defecto, "present")
#   "size": tamaño del LV (obligatorio si "present"); puede usarse B, b, S, s, K, k, M, m, G, g, T, t, P, p, E, e
#   "force": fuerza la operación de destruir un LV aunque las condiciones no lo aconsejen (p. ej. el LV tiene un sistema de ficheros y está montado); "true"|"false" (por defecto, "false")
#    "active": si el estado del LV es activo o inactivo; "true"|"false" (aplicable solo si "present"; por defecto, "true")

# valor devuelto:
#       0 OK con cambios
#       128 OK sin cambios
#       1 ejecución sin ser superusuario
#       2 error en argumentos
#       3 error por no estar instalado el paquete requerido
#       4 error porque no existe el VG
#       5 error en mandato que crea el LV
#       6 error en mandato que elimina el LV
#       7 error en mandato que redimensiona el LV
#       8 error en mandato que activa/desactiva el LV

# requisitos:
#       - debe estar instalado previamente el paquete lvm2

size_in_bytes() {
    size=$(tr '[a-z]' '[A-Z]' <<< $1)
    size_B=0
    [[ $size =~ ^[0-9]+$ ]] && size="$size"M
    [[ $size =~ ^[0-9]+[BSKMGTPE]$ ]] || return 1 # formato erróneo
    [[ $size =~ ^[0-9]+B$ ]] && size=$(sed 's/B//' <<< $size)
    [[ $size =~ ^[0-9]+S$ ]] && size=$(( $(sed 's/S//' <<< $size) * 512))
    size_B=$(numfmt --from=iec $size)
    test $(( size_B % 512 )) -ne 0 && return 1 # debe ser múltiplo de 512
    ext_size=$(( 2 ** 22 ))
    size_B=$(( ((size_B + $ext_size - 1) / $ext_size) * $ext_size ))
    echo $size_B
    return 0
}
test $(id -u) = 0 || exit 1 # debe ejecutarse como superusuario
. $(dirname $0)/prologue # incluye el prólogo

# valores por defecto
state=${state:-present}
active=${active:-true}
force=${force:-false}

# comprueba los argumentos
test -n "$lv" || { echo "lv: falta el argumento lv" >&2; exit 2; }
test -n "$vg" || { echo "lv: falta el argumento vg" >&2; exit 2; }
[[ $state == present || $state == absent ]] || { echo "lv: state debe ser present o absent" >&2; exit 2; }
[[ $active == true || $active == false ]] || { echo "lv: active debe ser true o false" >&2; exit 2; }
[[ $force == true || $force == false ]] || { echo "lv: force debe ser true o false" >&2; exit 2; }
if test $state = present
then
    test -n "$size" || { echo "lv: falta el argumento size" >&2; exit 2; }
    # convertir el tamaño a bytes (también valida su formato)
    size_B=$(size_in_bytes "$size") || { echo "lv: formato de size erróneo" >&2; exit 2; }
fi

# comprueba que lvm2 está instalado
lvm2_instalado() {
    if command -v dpkg-query &> /dev/null
    then
        dpkg-query -W -f='${Status}' lvm2 2> /dev/null | grep -q "install ok installed"
    else
        command -v lvcreate &> /dev/null
    fi
}
lvm2_instalado || { echo "lv: el paquete lvm2 no está instalado" >&2; exit 3; }

# comprueba que el VG existe
vgs "$vg" &> /dev/null || { echo "lv: el VG $vg no existe" >&2; exit 4; }

# determina si el LV existe
lvs "$vg/$lv" &> /dev/null
existe=$?

if test $state = absent
then
    test $existe -ne 0 && exit 128 # ya no existe
    if test $force = true
    then
        lvremove -f -y "$vg/$lv" &> /dev/null || exit 6
    else
        lvremove -y "$vg/$lv" &> /dev/null || exit 6
    fi
    exit 0
fi

# opciones según force (sin force se responde "no" a cualquier confirmación)
if test $force = true
then
    opts="-f"
    entrada="y"
else
    opts=""
    entrada="n"
fi

# state=present y el LV no existe: se crea (queda activo)
if test $existe -ne 0
then
    # -y: borra posibles firmas antiguas en el espacio recién asignado
    lvcreate $opts -y -L "$size" -n "$lv" "$vg" &> /dev/null || exit 5
    if test $active = false
    then
        lvchange -an "$vg/$lv" &> /dev/null || exit 8
    fi
    exit 0
fi

# state=present y el LV existe: redimensiona y activa/desactiva si es necesario
cambios=false

actual_B=$(lvs --noheadings --nosuffix --units b -o lv_size "$vg/$lv" 2> /dev/null | tr -d ' ')
if test "$actual_B" != "$size_B"
then
    lvresize $opts -L "$size" "$vg/$lv" <<< "$entrada" &> /dev/null || exit 7
    cambios=true
fi

attr=$(lvs --noheadings -o lv_attr "$vg/$lv" 2> /dev/null | tr -d ' ')
test "${attr:4:1}" = a && activo=true || activo=false
if test $activo != $active
then
    if test $active = true
    then
        lvchange -ay "$vg/$lv" &> /dev/null || exit 8
    else
        lvchange -an "$vg/$lv" &> /dev/null || exit 8
    fi
    cambios=true
fi

test $cambios = true && exit 0
exit 128
