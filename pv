#!/bin/bash

# gestiona un volumen físico (PV) a partir de un dispositivo de bloques

# argumentos:
#   "device": nombre del dispositivo de bloques (obligatorio)
#   "state": "present"|"absent" (por defecto, "present")
#   "resize": ajusta el tamaño del PV al del dispositivo subyacente; "true"|"false" (aplicable solo si "present" y el dispositivo ya es un PV; por defecto, "false")
#   "force": fuerza la operación de crear o destruir un PV aunque las condiciones no lo aconsejen (p. ej. el PV forma parte de un VG); "true"|"false" (por defecto, "false")

# valor devuelto:
#    0 OK con cambios
#    128 OK sin cambios
#    1 ejecución sin ser superusuario
#    2 error en argumentos
#    3 error por no estar instalado el paquete requerido
#    4 error porque el dispositivo no existe o no es de bloques
#    5 error en mandato que crea el PV
#    6 error en mandato que elimina el PV
#    7 error en mandato que redimensiona el PV

# requisitos previos:
#     - debe estar instalado previamente el paquete lvm2

test $(id -u) = 0 || exit 1 # debe ejecutarse como superusuario
. $(dirname $0)/prologue # incluye el prólogo

